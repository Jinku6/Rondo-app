{
  "expo": {
    "name": "Rondo",
    "slug": "rondo",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "rondo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jinku620.rondo",
      "associatedDomains": [
        "applinks:rondofc.app"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "maps",
          "comgooglemaps",
          "waze",
          "maps"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jinku620.rondo",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "rondofc.app",
              "pathPrefix": "/match"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rondo necesita tu ubicación para mostrarte partidos cercanos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rondo necesita acceder a tus fotos para que puedas elegir una foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "rondo-sl"
        }
      ],
      "./plugins/with-android-play-console-compat"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "06d2e120-ca35-4e90-9725-eb1a8ada0cb1"
      }
    },
    "owner": "jinku620",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/06d2e120-ca35-4e90-9725-eb1a8ada0cb1"
    }
  }
}
